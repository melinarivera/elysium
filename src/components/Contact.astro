---
// src/components/Contact.astro
import { siteConfig, withBase } from '@config/site';
const { contact } = siteConfig;
---

<section class="section-padding bg-gray-light" id="contacto-seccion" aria-labelledby="contact-heading">
  <div class="container-main">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-start">
      <!-- Información de contacto -->
      <div>
        <div class="animate-on-scroll">
          <span class="eyebrow">Contacto</span>
          <h2
            id="contact-heading"
            class="font-serif text-navy mt-3 mb-6 text-balance"
            style="font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.15; font-weight: 600;"
          >
            Construyamos una conversación
          </h2>
          <p class="text-text-dark/70 leading-relaxed mb-10">
            Si deseas conocer más sobre Grupo Elysium y nuestro enfoque institucional, ponte en contacto con nosotros.
          </p>
        </div>

        <!-- Datos de contacto -->
        <div class="space-y-6 animate-on-scroll" style="transition-delay: 0.15s;">
          {contact.email ? (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-navy flex items-center justify-center shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="white" stroke-width="1.5"/>
                  <polyline points="22,6 12,13 2,6" stroke="white" stroke-width="1.5"/>
                </svg>
              </div>
              <div>
                <div class="text-silver text-xs tracking-widest uppercase font-sans mb-1">Correo electrónico</div>
                <a href={`mailto:${contact.email}`} class="text-navy font-medium hover:text-navy-deep transition-colors">
                  {contact.email}
                </a>
              </div>
            </div>
          ) : (
            <div class="flex items-start gap-4 opacity-50">
              <div class="w-10 h-10 bg-silver/30 flex items-center justify-center shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" stroke="#A7B0BC" stroke-width="1.5"/>
                  <polyline points="22,6 12,13 2,6" stroke="#A7B0BC" stroke-width="1.5"/>
                </svg>
              </div>
              <div>
                <div class="text-silver text-xs tracking-widest uppercase font-sans mb-1">Correo electrónico</div>
                <span class="text-silver italic text-sm font-sans">Pendiente de confirmar</span>
              </div>
            </div>
          )}

          {contact.phone && (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-navy flex items-center justify-center shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <div>
                <div class="text-silver text-xs tracking-widest uppercase font-sans mb-1">Teléfono</div>
                <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="text-navy font-medium hover:text-navy-deep transition-colors">
                  {contact.phone}
                </a>
              </div>
            </div>
          )}

          {contact.city && (
            <div class="flex items-start gap-4">
              <div class="w-10 h-10 bg-navy flex items-center justify-center shrink-0 mt-0.5">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" stroke="white" stroke-width="1.5"/>
                  <circle cx="12" cy="10" r="3" stroke="white" stroke-width="1.5"/>
                </svg>
              </div>
              <div>
                <div class="text-silver text-xs tracking-widest uppercase font-sans mb-1">Ubicación</div>
                <span class="text-navy font-medium">{contact.city}</span>
              </div>
            </div>
          )}

          {/* WhatsApp — solo se muestra si hay número configurado */}
          {contact.whatsapp && (
            <div class="pt-4">
              <a
                href={`https://wa.me/${contact.whatsapp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 bg-[#25D366] text-white px-6 py-3.5 text-sm font-medium transition-all duration-300 hover:bg-[#1DA851]"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="white" aria-hidden="true">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                  <path d="M12 0C5.373 0 0 5.373 0 12c0 2.136.562 4.135 1.539 5.861L0 24l6.336-1.521C8.028 23.46 9.983 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm.029 21.954c-1.849 0-3.667-.479-5.272-1.389l-.378-.224-3.922.941.987-3.8-.248-.4C2.075 15.388 1.54 13.742 1.54 12c0-5.762 4.699-10.454 10.489-10.454 5.789 0 10.488 4.692 10.488 10.454 0 5.763-4.699 10.454-10.488 10.454z"/>
                </svg>
                Contactar por WhatsApp
              </a>
            </div>
          )}
        </div>

        <!-- Aviso de privacidad link -->
        <div class="mt-10 pt-8 border-t border-silver/20 animate-on-scroll" style="transition-delay: 0.3s;">
          <p class="text-text-dark/50 text-xs font-sans">
            Al contactarnos, aceptas nuestro{' '}
            <a href={withBase('/aviso-de-privacidad')} class="text-navy underline hover:text-navy-deep transition-colors">
              Aviso de Privacidad
            </a>.
          </p>
        </div>
      </div>

      <!-- Formulario de contacto -->
      <div class="animate-on-scroll" style="transition-delay: 0.2s;">
        <div class="bg-white p-8 md:p-10 shadow-card">
          <!-- Aviso de integración pendiente -->
          <div class="bg-amber-50 border border-amber-200 p-4 mb-8 text-xs text-amber-800 font-sans leading-relaxed">
            <strong>Nota de desarrollo:</strong> El formulario requiere integración con un servicio de envío de correo (p. ej. Resend, Formspree o un endpoint propio) antes de activarse en producción. Por el momento, los datos no se envían.
          </div>

          <form
            id="contact-form"
            novalidate
            aria-label="Formulario de contacto"
          >
            <!-- Nombre -->
            <div class="mb-6">
              <label for="name" class="block text-navy text-sm font-medium mb-2 font-sans">
                Nombre <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                class="w-full border border-silver/40 bg-warm-white px-4 py-3 text-text-dark text-sm font-sans focus:border-navy focus:outline-none transition-colors duration-200"
                placeholder="Tu nombre completo"
              />
            </div>

            <!-- Organización -->
            <div class="mb-6">
              <label for="organization" class="block text-navy text-sm font-medium mb-2 font-sans">
                Organización <span class="text-silver text-xs">(opcional)</span>
              </label>
              <input
                type="text"
                id="organization"
                name="organization"
                autocomplete="organization"
                class="w-full border border-silver/40 bg-warm-white px-4 py-3 text-text-dark text-sm font-sans focus:border-navy focus:outline-none transition-colors duration-200"
                placeholder="Nombre de tu estancia o institución"
              />
            </div>

            <!-- Email -->
            <div class="mb-6">
              <label for="email" class="block text-navy text-sm font-medium mb-2 font-sans">
                Correo electrónico <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                class="w-full border border-silver/40 bg-warm-white px-4 py-3 text-text-dark text-sm font-sans focus:border-navy focus:outline-none transition-colors duration-200"
                placeholder="correo@ejemplo.com"
              />
            </div>

            <!-- Teléfono -->
            <div class="mb-6">
              <label for="phone" class="block text-navy text-sm font-medium mb-2 font-sans">
                Teléfono <span class="text-silver text-xs">(opcional)</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                autocomplete="tel"
                class="w-full border border-silver/40 bg-warm-white px-4 py-3 text-text-dark text-sm font-sans focus:border-navy focus:outline-none transition-colors duration-200"
                placeholder="+52 55 0000 0000"
              />
            </div>

            <!-- Ciudad -->
            <div class="mb-6">
              <label for="city" class="block text-navy text-sm font-medium mb-2 font-sans">
                Ciudad <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <input
                type="text"
                id="city"
                name="city"
                required
                class="w-full border border-silver/40 bg-warm-white px-4 py-3 text-text-dark text-sm font-sans focus:border-navy focus:outline-none transition-colors duration-200"
                placeholder="Ciudad de México, Monterrey..."
              />
            </div>

            <!-- Mensaje -->
            <div class="mb-6">
              <label for="message" class="block text-navy text-sm font-medium mb-2 font-sans">
                Mensaje <span class="text-red-500" aria-hidden="true">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                required
                rows="4"
                class="w-full border border-silver/40 bg-warm-white px-4 py-3 text-text-dark text-sm font-sans focus:border-navy focus:outline-none transition-colors duration-200 resize-none"
                placeholder="Cuéntanos sobre tu estancia o centro y cómo podemos ayudarte."
              ></textarea>
            </div>

            <!-- Casilla de privacidad -->
            <div class="mb-8">
              <label class="flex items-start gap-3 cursor-pointer">
                <input
                  type="checkbox"
                  id="privacy"
                  name="privacy"
                  required
                  class="mt-0.5 w-4 h-4 border-silver/40 accent-navy shrink-0"
                />
                <span class="text-text-dark/70 text-xs font-sans leading-relaxed">
                  He leído y acepto el{' '}
                  <a href={withBase('/aviso-de-privacidad')} class="text-navy underline hover:text-navy-deep transition-colors" target="_blank">
                    Aviso de Privacidad
                  </a>{' '}
                  de Grupo Elysium. <span class="text-red-500" aria-hidden="true">*</span>
                </span>
              </label>
            </div>

            <!-- Botón de envío -->
            <button
              type="submit"
              class="btn-primary w-full justify-center text-sm"
            >
              Enviar mensaje
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>

            <!-- Zona de estado (JS) -->
            <div id="form-status" role="status" aria-live="polite" class="mt-4 hidden"></div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusEl = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Validación básica del lado del cliente
    const requiredFields = form.querySelectorAll('[required]');
    let valid = true;
    requiredFields.forEach((field) => {
      const el = field as HTMLInputElement | HTMLTextAreaElement;
      if (!el.value.trim()) {
        el.classList.add('border-red-400');
        valid = false;
      } else {
        el.classList.remove('border-red-400');
      }
    });

    if (!valid) {
      if (statusEl) {
        statusEl.textContent = 'Por favor, completa todos los campos obligatorios.';
        statusEl.className = 'mt-4 p-4 bg-red-50 border border-red-200 text-red-700 text-sm font-sans';
        statusEl.classList.remove('hidden');
      }
      return;
    }

    // PENDIENTE DE INTEGRACIÓN: conectar a servicio de envío real
    if (statusEl) {
      statusEl.innerHTML = `
        <div class="p-4 bg-amber-50 border border-amber-200 text-amber-800 text-sm font-sans leading-relaxed">
          <strong>Formulario en desarrollo.</strong> El sistema de envío aún no está integrado. Por favor, escríbenos directamente cuando dispongas de los canales de contacto oficiales.
        </div>
      `;
      statusEl.classList.remove('hidden');
    }
  });
</script>
