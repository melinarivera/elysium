---
// src/components/Hero.astro
import { siteConfig, withBase } from '@config/site';
const { hero, foundingYear } = siteConfig;
---

<section class="relative bg-navy-deep overflow-hidden min-h-[90vh] flex items-center" id="inicio" aria-labelledby="hero-heading">
  <!-- Fondo decorativo -->
  <div class="absolute inset-0" aria-hidden="true">
    <!-- Gradiente de profundidad -->
    <div class="absolute inset-0 bg-gradient-to-br from-navy-deep via-navy to-[#0d3060]"></div>
    <!-- Líneas decorativas finas -->
    <div class="absolute top-0 left-0 w-full h-px bg-silver/10"></div>
    <div class="absolute bottom-0 left-0 w-full h-px bg-silver/10"></div>
    <!-- Patrón de puntos sutil -->
    <div
      class="absolute inset-0 opacity-[0.03]"
      style="background-image: radial-gradient(circle, #A7B0BC 1px, transparent 1px); background-size: 40px 40px;"
    ></div>
    <!-- Línea vertical derecha decorativa -->
    <div class="absolute top-0 right-1/4 w-px h-full bg-silver/10 hidden lg:block"></div>
  </div>

  <div class="container-main relative z-10 py-24 md:py-32 lg:py-36">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">
      <!-- Columna de texto -->
      <div>
        <!-- Eyebrow -->
        <div class="flex items-center gap-3 mb-8 animate-on-scroll">
          <div class="w-8 h-px bg-silver/60"></div>
          <span class="eyebrow text-silver/80">{hero.eyebrow}</span>
        </div>

        <!-- H1 -->
        <h1
          id="hero-heading"
          class="font-serif text-warm-white text-balance animate-on-scroll"
          style="font-size: clamp(2.4rem, 4.5vw, 4rem); line-height: 1.1; letter-spacing: -0.02em; font-weight: 600; transition-delay: 0.1s;"
        >
          {hero.h1}
        </h1>

        <!-- Línea divisoria -->
        <div class="w-16 h-px bg-silver/40 mt-8 mb-8 animate-on-scroll" style="transition-delay: 0.15s;"></div>

        <!-- Subtítulo -->
        <p
          class="text-warm-white/70 font-sans text-lg leading-relaxed max-w-xl animate-on-scroll"
          style="transition-delay: 0.2s;"
        >
          {hero.subtitle}
        </p>

        <!-- Trayectoria -->
        {hero.showFoundingYear && (
          <div class="flex items-center gap-4 mt-10 mb-12 animate-on-scroll" style="transition-delay: 0.25s;">
            <div class="text-center">
              <div class="font-serif text-silver text-3xl font-light">{foundingYear}</div>
              <div class="text-silver/50 text-[11px] tracking-widest uppercase mt-0.5 font-sans">Desde</div>
            </div>
            <div class="w-px h-12 bg-silver/30"></div>
            <p class="text-warm-white/50 text-sm font-sans max-w-xs">
              Trayectoria institucional en gestión de estancias infantiles y educación inicial en México.
            </p>
          </div>
        )}

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 animate-on-scroll" style="transition-delay: 0.3s;">
          <a href={hero.cta1.href} class="btn-primary bg-warm-white text-navy hover:bg-gray-light text-sm">
            {hero.cta1.label}
          </a>
          <a href={hero.cta2.href} class="btn-outline-white text-sm">
            {hero.cta2.label}
          </a>
        </div>
      </div>

      <!-- Columna visual: composición con arquitectura de instalaciones y logotipo institucional -->
      <div class="hidden lg:flex flex-col items-center justify-center relative animate-on-scroll" style="transition-delay: 0.2s;">
        <div class="relative w-full max-w-lg">
          <!-- Marco decorativo posterior -->
          <div class="absolute -inset-4 border border-silver/15 rounded-sm"></div>

          <!-- Imagen arquitectónica de fondo -->
          <div class="relative overflow-hidden shadow-2xl border border-silver/20 rounded-sm">
            <img
              src={withBase('/images/hero-center.jpg')}
              alt="Instalaciones y arquitectura de centros de educación inicial gestionados por Grupo Elysium"
              width="640"
              height="480"
              class="w-full h-[380px] object-cover filter brightness-[0.88]"
              loading="eager"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-navy-deep via-navy-deep/40 to-transparent"></div>

            <!-- Placa flotante central con el logotipo oficial -->
            <div class="absolute inset-0 flex items-center justify-center p-6">
              <div class="bg-warm-white/95 backdrop-blur-md p-8 shadow-2xl border border-silver/30 flex flex-col items-center max-w-[280px] text-center transform transition-transform hover:scale-105 duration-500">
                <img
                  src={withBase('/images/logo-grupo-elysium.jpg')}
                  alt="Logotipo oficial Grupo Elysium — edificio clásico sobre libro abierto"
                  width="130"
                  height="130"
                  class="w-28 h-28 object-contain mb-3"
                  loading="eager"
                />
                <div class="w-12 h-px bg-silver/40 my-1"></div>
                <span class="text-navy font-serif text-sm font-semibold tracking-wider">GRUPO ELYSIUM</span>
                <span class="text-silver text-[9px] tracking-widest uppercase font-sans">México · Desde 2007</span>
              </div>
            </div>

            <!-- Etiqueta inferior -->
            <div class="absolute bottom-4 left-6 right-6 flex justify-between items-center text-warm-white/80 text-xs font-sans">
              <span class="flex items-center gap-1.5 text-silver/80">
                <span class="w-1.5 h-1.5 bg-silver rounded-full"></span>
                Gestión Integral
              </span>
              <span class="text-silver/60">Primera Infancia</span>
            </div>
          </div>
        </div>

        <!-- Indicadores decorativos inferiores -->
        <div class="grid grid-cols-3 gap-8 mt-12 w-full max-w-xs">
          <div class="text-center">
            <div class="font-serif text-silver text-2xl font-light">2007</div>
            <div class="text-warm-white/40 text-[10px] tracking-widest uppercase mt-1 font-sans">Fundación</div>
          </div>
          <div class="text-center">
            <div class="font-serif text-silver text-2xl font-light">6</div>
            <div class="text-warm-white/40 text-[10px] tracking-widest uppercase mt-1 font-sans">Áreas clave</div>
          </div>
          <div class="text-center">
            <div class="font-serif text-silver text-2xl font-light">MX</div>
            <div class="text-warm-white/40 text-[10px] tracking-widest uppercase mt-1 font-sans">Cobertura</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-on-scroll" style="transition-delay: 0.5s;" aria-hidden="true">
    <div class="text-silver/40 text-[10px] tracking-widest uppercase font-sans">Explorar</div>
    <div class="w-px h-8 bg-gradient-to-b from-silver/40 to-transparent"></div>
  </div>
</section>
