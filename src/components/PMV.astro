---
// src/components/PMV.astro — Propósito, Misión y Visión
import { siteConfig } from '@config/site';
const { pmv } = siteConfig;

// Iconos SVG por bloque
const icons: Record<string, string> = {
  purpose: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <circle cx="14" cy="14" r="10" stroke="currentColor" stroke-width="1.4"/>
    <circle cx="14" cy="14" r="4" fill="currentColor" opacity="0.3"/>
    <path d="M14 4v3M14 21v3M4 14h3M21 14h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>`,
  mission: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <path d="M14 4L4 10v8l10 6 10-6v-8L14 4z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    <path d="M14 4v16M4 10l10 6 10-6" stroke="currentColor" stroke-width="1.4"/>
  </svg>`,
  vision: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
    <ellipse cx="14" cy="14" rx="10" ry="6" stroke="currentColor" stroke-width="1.4"/>
    <circle cx="14" cy="14" r="3" fill="currentColor" opacity="0.4"/>
    <path d="M4 4l20 20" stroke="currentColor" stroke-width="1" opacity="0.2" stroke-linecap="round"/>
  </svg>`,
};
---

<section class="section-padding bg-gray-light" id="enfoque" aria-labelledby="pmv-heading">
  <div class="container-main">
    <!-- Encabezado -->
    <div class="text-center max-w-2xl mx-auto mb-16 animate-on-scroll">
      <span class="eyebrow">Nuestro enfoque</span>
      <h2
        id="pmv-heading"
        class="font-serif text-navy mt-3 text-balance"
        style="font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.15; font-weight: 600;"
      >
        Propósito, Misión y Visión
      </h2>
      <div class="w-12 h-px bg-silver/60 mx-auto mt-6"></div>
    </div>

    <!-- Tres bloques -->
    <div class="grid md:grid-cols-3 gap-1">
      {pmv.map((item, i) => (
        <article
          class="relative bg-white p-10 md:p-12 animate-on-scroll group transition-all duration-300 hover:shadow-card-hover"
          style={`transition-delay: ${i * 0.15}s;`}
        >
          <!-- Número de fondo decorativo -->
          <div
            class="absolute top-8 right-8 font-serif text-7xl font-light text-gray-light/70 select-none leading-none"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </div>

          <!-- Icono -->
          <div class="w-12 h-12 border border-silver/40 flex items-center justify-center text-navy mb-8 group-hover:border-navy/30 transition-colors duration-300">
            <Fragment set:html={icons[item.icon] ?? icons.purpose} />
          </div>

          <!-- Etiqueta -->
          <div class="eyebrow mb-3">{item.label}</div>

          <!-- Texto -->
          <p class="text-text-dark/80 leading-relaxed text-[0.95rem]">{item.text}</p>

          <!-- Línea inferior decorativa -->
          <div class="absolute bottom-0 left-0 w-0 h-0.5 bg-navy group-hover:w-full transition-all duration-500"></div>
        </article>
      ))}
    </div>
  </div>
</section>
