---
// src/components/Values.astro
import { siteConfig } from '@config/site';
const { values } = siteConfig;
---

<section class="section-padding bg-gray-light" id="valores" aria-labelledby="values-heading">
  <div class="container-main">
    <!-- Encabezado -->
    <div class="text-center max-w-2xl mx-auto mb-16 animate-on-scroll">
      <span class="eyebrow">Valores institucionales</span>
      <h2
        id="values-heading"
        class="font-serif text-navy mt-3 text-balance"
        style="font-size: clamp(1.75rem, 3vw, 2.75rem); line-height: 1.15; font-weight: 600;"
      >
        Principios que orientan nuestra manera de trabajar
      </h2>
      <div class="w-12 h-px bg-silver/60 mx-auto mt-6"></div>
    </div>

    <!-- Grid de valores -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {values.slice(0, 4).map((value, i) => (
        <article
          class="card-base group animate-on-scroll"
          style={`transition-delay: ${i * 0.1}s;`}
        >
          <!-- Inicial decorativa -->
          <div
            class="font-serif text-6xl font-light text-silver/20 leading-none mb-4 select-none group-hover:text-navy/10 transition-colors duration-500"
            aria-hidden="true"
          >
            {value.name.charAt(0)}
          </div>
          <h3 class="font-serif text-navy text-lg font-semibold mb-3">{value.name}</h3>
          <p class="text-text-dark/65 text-sm leading-relaxed">{value.description}</p>
        </article>
      ))}
    </div>

    <!-- Fila inferior (3 tarjetas centradas) -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6 lg:max-w-3xl lg:mx-auto">
      {values.slice(4).map((value, i) => (
        <article
          class="card-base group animate-on-scroll"
          style={`transition-delay: ${(i + 4) * 0.1}s;`}
        >
          <div
            class="font-serif text-6xl font-light text-silver/20 leading-none mb-4 select-none group-hover:text-navy/10 transition-colors duration-500"
            aria-hidden="true"
          >
            {value.name.charAt(0)}
          </div>
          <h3 class="font-serif text-navy text-lg font-semibold mb-3">{value.name}</h3>
          <p class="text-text-dark/65 text-sm leading-relaxed">{value.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
